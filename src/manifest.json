{
    "manifest_version":  3,
    "name":  "MeTube Downloader",
    "version":  "1.8.2",
    "description":  "Queue download to your MeTube instance",
    "permissions":  [
                        "contextMenus",
                        "storage",
                        "tabs",
                        "notifications"
                    ],
    "host_permissions":  [
                             "http://*/*",
                             "https://*/*"
                         ],
    "icons":  {
                  "16":  "icons/icon-19.png",
                  "48":  "icons/icon-38.png"
              },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "options_ui":  {
                       "page":  "options/options.html",
                       "browser_style":  true
                   },
    "action":  {
                   "default_icon":  {
                                        "16":  "icons/icon-19.png",
                                        "48":  "icons/icon-38.png"
                                    },
                   "default_title":  "Send to MeTube",
                   "default_popup":  "popup/popup.html"
               }
}
